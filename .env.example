# Copy this to .env for LOCAL testing only (never commit a real .env -- it's
# gitignored). In Railway, set these as actual environment variables on each
# service instead of using a file. See README.md "Environment variables" for
# where to get each value.

# ---- shared by both services ------------------------------------------------
SUPABASE_URL=https://wfpaakmjveuhugskqmup.supabase.co

# ---- pipeline service --------------------------------------------------------
SUPABASE_SERVICE_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", "...": "... full JSON key contents, all on one line ..."}
# Optional overrides (defaults already point at the household's real folders):
# GOOGLE_DRIVE_ROOT_FOLDER_ID=1Vdnu5u9doehcyNdNZJLxvD7OTaYSPx8a
# GOOGLE_DRIVE_STANDARDIZED_FOLDER_ID=15bTjig6O9mUQ8TZ5jV1avfHSDA2LJl5r
# Powers the LLM categorization fallback for keyword-unmatched rows (see
# README.md "LLM categorization fallback"). Same value as the dashboard's key
# below. If unset, that step is just skipped -- no error, no crash.
ANTHROPIC_API_KEY=

# ---- dashboard service --------------------------------------------------------
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
DASHBOARD_PASSWORD=
# Optional: separates the cookie-signing key from the login password.
# SESSION_SECRET=
# Required for "Run Pipeline Now" on the Home page -- the dashboard now
# imports and can invoke the pipeline package directly, so it needs Drive
# access too (same value as the pipeline service's own key above).
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", "...": "... full JSON key contents, all on one line ..."}
# Required for the Ask page (Claude-backed Q&A). Get one at console.anthropic.com.
# If unset, the Ask page shows a "not configured yet" message instead of crashing.
ANTHROPIC_API_KEY=
